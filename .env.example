# --- SOCIODEX SUPABASE BACKEND CONFIGURATION ---
# Replace these with your actual Supabase Project URL and Anon API Key
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- RESEND TRANSACTIONAL EMAIL API CONFIGURATION ---
# Replace with your Resend API Key (get it from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here
VITE_RESEND_API_KEY=re_your_resend_api_key_here
VITE_RESEND_FROM_EMAIL=celebrations@yourdomain.com

# --- TWILIO WHATSAPP AUTOMATION CONFIGURATION ---
# Replace with your Twilio Account SID, Auth Token / API Key, and From Number
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_or_api_key
VITE_TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_or_api_key
VITE_TWILIO_FROM_NUMBER=+14155238886
